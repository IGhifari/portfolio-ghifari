# [REQUIRED for /api/chat] Google Gemini API key used by the AI Portfolio Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# [REQUIRED for /api/chat] Upstash Redis REST credentials for fail-closed rate limiting

UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

ALLOWED_ORIGIN=https://www.ighifari.my.id,https://ighifari.my.id,http://localhost:5173

# [OPTIONAL] GitHub personal access token to increase /api/github upstream rate limits

GITHUB_TOKEN=

# [OPTIONAL] Override Gemini model ID (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

VITE_SITE_ORIGIN=https://www.ighifari.my.id

# [OPTIONAL] EmailJS public identifiers for the Contact section email form
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key